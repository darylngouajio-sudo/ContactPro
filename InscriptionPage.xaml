<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="contactpro.InscriptionPage"
    Title="Inscription"
    BackgroundColor="#F4F7FC">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Label Text="CONTACTPRO"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="#246BFD" />

            <Label Text="Créer un compte"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#173B67" />

            <Label Text="Rejoins ContactPro pour organiser tes contacts."
                   FontSize="14"
                   TextColor="#68778D" />

            <Entry x:Name="NomInscriptionEntry"
                   Placeholder="Nom complet"
                   BackgroundColor="White" />

            <Entry x:Name="EmailInscriptionEntry"
                   Placeholder="Adresse e-mail"
                   Keyboard="Email"
                   BackgroundColor="White" />

            <Entry x:Name="MotDePasseEntry"
                   Placeholder="Mot de passe"
                   IsPassword="True"
                   BackgroundColor="White" />

            <Button Text="Créer mon compte"
                    BackgroundColor="#246BFD"
                    TextColor="White"
                    CornerRadius="12"
                    Clicked="OnInscriptionClicked" />

            <Label x:Name="MessageInscriptionLabel"
                   Text=""
                   FontSize="14"
                   TextColor="#173B67" />

            <Button Text="Retour à l'accueil"
                    BackgroundColor="#173B67"
                    TextColor="White"
                    Clicked="OnRetourAccueilClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>